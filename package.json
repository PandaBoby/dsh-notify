{
  "name": "dsh-notify",
  "version": "0.1.0",
  "description": "Clickable task-completion notifications for DeepSeek Harness sessions: native Web/desktop notifications that focus the app and open the finished session, with macOS osascript and Linux notify-send fallbacks. No shell, zero dependencies.",
  "icon": "icon.svg",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/*": "./lib/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/",
    "smoke": "node test/smoke-notify.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "notifications",
    "macos",
    "notify-send",
    "productivity"
  ],
  "license": "MIT",
  "author": "PandaBoby",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PandaBoby/dsh-notify.git"
  },
  "homepage": "https://github.com/PandaBoby/dsh-notify#readme",
  "bugs": {
    "url": "https://github.com/PandaBoby/dsh-notify/issues"
  }
}
